root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{uss,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,mjs,asmdef}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/Fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = false

# Unity writes these; leave them as Unity does.
[*.{meta,asset,unity,prefab,mat,inputactions}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
