{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "e2fc27566d222ac625daba7be56181cd80077111",
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "packages": {
    ".": {
      "release-type": "simple",
      "draft": true,
      "component": "unity-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "Packages/com.scenario.unity/CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous Chores" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "test", "section": "Tests" },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "build", "section": "Build System" }
      ],
      "extra-files": [
        { "type": "json", "path": "Packages/com.scenario.unity/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "Packages/com.scenario.unity/Editor/Core/McpClient.cs" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  }
}
